# 外部服务凭据只填写到本地 .env；不要提交真实密码或 API Key。
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_me
NEO4J_DATABASE=neo4j

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=replace_me
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=ai_medical

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL_PATH=pretrained/bge-base-zh-v1.5

CHROMA_DIR=data/vectorstore
CHROMA_COLLECTION=ai_medical
DATASYNC_APPLY_ENABLED=false

RAG_ENABLED=false
LLM_ENABLED=false
CHECKPOINT_BACKEND=memory
MAX_QUESTION_COUNT=6
DEMO_TRACE_ENABLED=false
